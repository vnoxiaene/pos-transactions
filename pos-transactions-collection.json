{
  "info": {
    "name": "POS Transactions API - Dev Collection",
    "description": "Collection para validar a cadeia completa de transações POS em ambiente de dev.\n\nCenários cobertos:\n1. Autorizar transação nova\n2. Idempotência na autorização\n3. Confirmar transação\n4. Idempotência na confirmação\n5. Void por transactionId\n6. Void por NSU + terminalId\n7. Idempotência no void\n8. Health check / Circuit Breaker status",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:8080", "type": "string" },
    { "key": "hmacSecret",    "value": "my-super-secret-key-change-in-production", "type": "string" },
    { "key": "terminalId",    "value": "T-1000", "type": "string" },
    { "key": "nsu",           "value": "", "type": "string" },
    { "key": "transactionId", "value": "", "type": "string" },
    { "key": "voidNsu",       "value": "", "type": "string" },
    { "key": "voidTransactionId", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Gera HMAC-SHA256 para autenticação de cada requisição",
          "const secret = pm.collectionVariables.get('hmacSecret');",
          "const timestamp = Math.floor(Date.now() / 1000).toString();",
          "const body = (pm.request.body && pm.request.body.raw) ? pm.request.body.raw : '';",
          "const payload = timestamp + '.' + body;",
          "const signature = CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex);",
          "pm.request.headers.upsert({ key: 'X-Timestamp',    value: timestamp });",
          "pm.request.headers.upsert({ key: 'X-Signature',    value: signature });",
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: pm.variables.replaceIn('{{$guid}}') });",
          "pm.request.headers.upsert({ key: 'Content-Type',   value: 'application/json' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Autorizar Transação",
      "item": [
        {
          "name": "1.1 POST Authorize - Nova Transação",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Gera NSU único para não colidir com execuções anteriores",
                  "const nsu = 'NSU-' + Date.now();",
                  "pm.collectionVariables.set('nsu', nsu);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Body contém transactionId', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.transactionId).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('transactionId', body.transactionId);",
                  "});",
                  "pm.test('Body contém nsu, terminalId e amount', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.nsu).to.equal(pm.collectionVariables.get('nsu'));",
                  "    pm.expect(body.terminalId).to.equal(pm.collectionVariables.get('terminalId'));",
                  "    pm.expect(body.amount).to.equal(199.90);",
                  "});",
                  "pm.test('X-Correlation-Id presente na resposta', () => {",
                  "    pm.expect(pm.response.headers.get('X-Correlation-Id')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nsu\": \"{{nsu}}\",\n  \"amount\": 199.90,\n  \"terminalId\": \"{{terminalId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/authorize",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "authorize"]
            }
          }
        },
        {
          "name": "1.2 POST Authorize - Idempotência (mesmo NSU + Terminal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK (idempotente)', () => pm.response.to.have.status(200));",
                  "pm.test('Mesmo transactionId retornado', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.transactionId).to.equal(pm.collectionVariables.get('transactionId'));",
                  "});",
                  "pm.test('Nenhuma nova transação criada', () => {",
                  "    pm.expect(pm.response.json().transactionId).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nsu\": \"{{nsu}}\",\n  \"amount\": 199.90,\n  \"terminalId\": \"{{terminalId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/authorize",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "authorize"]
            }
          }
        },
        {
          "name": "1.3 POST Authorize - Validação (campos obrigatórios)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Mensagem de erro presente', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.message).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/authorize",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "authorize"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Confirmar Transação",
      "item": [
        {
          "name": "2.1 POST Confirm - Sucesso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('Body vazio', () => pm.expect(pm.response.text()).to.be.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{transactionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "confirm"]
            }
          }
        },
        {
          "name": "2.2 POST Confirm - Idempotência (já confirmado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204 No Content (idempotente)', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{transactionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "confirm"]
            }
          }
        },
        {
          "name": "2.3 POST Confirm - Transação não encontrada",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"TXN-NAO-EXISTE-00000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "confirm"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Desfazer Transação (Void)",
      "item": [
        {
          "name": "3.0 POST Authorize - Cria transação para void",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const nsu = 'VOID-NSU-' + Date.now();",
                  "pm.collectionVariables.set('voidNsu', nsu);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('voidTransactionId', body.transactionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nsu\": \"{{voidNsu}}\",\n  \"amount\": 50.00,\n  \"terminalId\": \"{{terminalId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/authorize",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "authorize"]
            }
          }
        },
        {
          "name": "3.1 POST Void - Por transactionId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('Body vazio', () => pm.expect(pm.response.text()).to.be.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{voidTransactionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/void",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "void"]
            }
          }
        },
        {
          "name": "3.2 POST Void - Idempotência (já desfeito)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204 No Content (idempotente)', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{voidTransactionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/void",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "void"]
            }
          }
        },
        {
          "name": "3.3 POST Authorize + Void - Por NSU + TerminalId",
          "item": [
            {
              "name": "3.3a POST Authorize para void por NSU",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "pm.collectionVariables.set('voidNsu', 'NSU-BY-TERMINAL-' + Date.now());"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status 200', () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nsu\": \"{{voidNsu}}\",\n  \"amount\": 75.00,\n  \"terminalId\": \"{{terminalId}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/v1/pos/transactions/authorize",
                  "host": ["{{baseUrl}}"],
                  "path": ["v1", "pos", "transactions", "authorize"]
                }
              }
            },
            {
              "name": "3.3b POST Void por NSU + TerminalId",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nsu\": \"{{voidNsu}}\",\n  \"terminalId\": \"{{terminalId}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/v1/pos/transactions/void",
                  "host": ["{{baseUrl}}"],
                  "path": ["v1", "pos", "transactions", "void"]
                }
              }
            }
          ]
        },
        {
          "name": "3.4 POST Void - Transação não encontrada",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"TXN-NAO-EXISTE-99999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/void",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "void"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Observabilidade e Resiliência",
      "item": [
        {
          "name": "4.1 GET Actuator Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status UP', () => pm.expect(pm.response.json().status).to.equal('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "4.2 GET Circuit Breaker Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health/circuitBreakers",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health", "circuitBreakers"]
            }
          }
        },
        {
          "name": "4.3 GET Metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "metrics"]
            }
          }
        }
      ]
    }
  ]
}
