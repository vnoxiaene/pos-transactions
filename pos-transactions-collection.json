{
  "info": {
    "name": "POS Transactions API - Dev Collection",
    "description": "Collection para validar a cadeia completa de transações POS em ambiente de dev.\n\nArquitetura multi-módulo (3 microserviços):\n  • pos-transactions-api  — porta 8080 (Core API com HMAC-SHA256)\n  • external-payment-mock — porta 8081 (Simulador de adquirente, sem autenticação)\n  • auth-commons          — biblioteca JAR (sem HTTP, usada internamente pela API)\n\nCenários cobertos:\n1. Autorizar transação nova\n2. Idempotência na autorização\n3. Confirmar transação\n4. Idempotência na confirmação\n5. Void por transactionId\n6. Void por NSU + terminalId\n7. Idempotência no void\n8. Erros de negócio (404, 422)\n9. Health check / Circuit Breaker status\n10. External Payment Mock — chamadas diretas de diagnóstico",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",          "value": "http://localhost:8080", "type": "string",
      "description": "URL base do pos-transactions-api" },
    { "key": "baseUrlMock",      "value": "http://localhost:8081", "type": "string",
      "description": "URL base do external-payment-mock" },
    { "key": "hmacSecret",       "value": "my-super-secret-key-change-in-production", "type": "string" },
    { "key": "terminalId",       "value": "T-1000", "type": "string" },
    { "key": "nsu",              "value": "", "type": "string" },
    { "key": "transactionId",    "value": "", "type": "string" },
    { "key": "voidNsu",          "value": "", "type": "string" },
    { "key": "voidTransactionId","value": "", "type": "string" },
    { "key": "hmacTimestamp",   "value": "", "type": "string" },
    { "key": "hmacSignature",   "value": "", "type": "string" },
    { "key": "correlationId",   "value": "", "type": "string" }
    ,{ "key": "recalculateHmacScript", "value": "const secret = pm.collectionVariables.get('hmacSecret');\nconst timestamp = Math.floor(Date.now() / 1000).toString();\nconst rawBody = (pm.request.body && pm.request.body.raw) ? pm.request.body.raw : '';\nconst resolvedBody = pm.variables.replaceIn(rawBody);\nconst payload = timestamp + '.' + resolvedBody;\nconst signature = CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex);\nconst correlationId = pm.variables.replaceIn('{{$guid}}');\npm.collectionVariables.set('hmacTimestamp', timestamp);\npm.collectionVariables.set('hmacSignature', signature);\npm.collectionVariables.set('correlationId', correlationId);", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Gera HMAC-SHA256 para autenticação de cada requisição (pos-transactions-api).",
          "// Mantém os valores em variáveis para que os headers apareçam no Code > cURL.",
          "const secret = pm.collectionVariables.get('hmacSecret');",
          "const timestamp = Math.floor(Date.now() / 1000).toString();",
          "const rawBody = (pm.request.body && pm.request.body.raw) ? pm.request.body.raw : '';",
          "const resolvedBody = pm.variables.replaceIn(rawBody);",
          "const payload = timestamp + '.' + resolvedBody;",
          "const signature = CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex);",
          "const correlationId = pm.variables.replaceIn('{{$guid}}');",
          "pm.collectionVariables.set('hmacTimestamp', timestamp);",
          "pm.collectionVariables.set('hmacSignature', signature);",
          "pm.collectionVariables.set('correlationId', correlationId);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Autorizar Transação",
      "item": [
        {
          "name": "1.1 POST Authorize - Nova Transação",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Gera NSU único para não colidir com execuções anteriores",
                  "const nsu = 'NSU-' + Date.now();",
                  "pm.collectionVariables.set('nsu', nsu);",
                  "// Reutiliza script de recálculo de HMAC definido em collection variable",
                  "eval(pm.collectionVariables.get('recalculateHmacScript'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Body contém transactionId', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.transactionId).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('transactionId', body.transactionId);",
                  "});",
                  "pm.test('Body contém nsu, terminalId e amount', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.nsu).to.equal(pm.collectionVariables.get('nsu'));",
                  "    pm.expect(body.terminalId).to.equal(pm.collectionVariables.get('terminalId'));",
                  "    pm.expect(body.amount).to.equal(199.90);",
                  "});",
                  "pm.test('X-Correlation-Id presente na resposta', () => {",
                  "    pm.expect(pm.response.headers.get('X-Correlation-Id')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Timestamp", "value": "{{hmacTimestamp}}" },
              { "key": "X-Signature", "value": "{{hmacSignature}}" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nsu\": \"{{nsu}}\",\n  \"amount\": 199.90,\n  \"terminalId\": \"{{terminalId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/authorize",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "authorize"]
            }
          }
        },
        {
          "name": "1.2 POST Authorize - Idempotência (mesmo NSU + Terminal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK (idempotente)', () => pm.response.to.have.status(200));",
                  "pm.test('Mesmo transactionId retornado', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.transactionId).to.equal(pm.collectionVariables.get('transactionId'));",
                  "});",
                  "pm.test('Nenhuma nova transação criada', () => {",
                  "    pm.expect(pm.response.json().transactionId).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Timestamp", "value": "{{hmacTimestamp}}" },
              { "key": "X-Signature", "value": "{{hmacSignature}}" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nsu\": \"{{nsu}}\",\n  \"amount\": 199.90,\n  \"terminalId\": \"{{terminalId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/authorize",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "authorize"]
            }
          }
        },
        {
          "name": "1.3 POST Authorize - Validação (campos obrigatórios)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Mensagem de erro presente', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.message).to.exist;",
                  "});",
                  "pm.test('Detalhes de validação presentes', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.details).to.be.an('array').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Timestamp", "value": "{{hmacTimestamp}}" },
              { "key": "X-Signature", "value": "{{hmacSignature}}" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/transactions/authorize",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "transactions", "authorize"]
            }
          }
        }
      ]
    },
